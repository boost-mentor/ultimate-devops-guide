# Terraform state — содержит СЕКРЕТЫ в открытом виде
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl КОММИТИМ: он фиксирует выбранные версии провайдера.
# Реальные значения переменных
terraform.tfvars
*.auto.tfvars
# Планы могут содержать чувствительные данные
*.tfplan
crash.log

# vars.auto.tfvars — публичные учебные значения, коммитим; личное — private.auto.tfvars
!vars.auto.tfvars
