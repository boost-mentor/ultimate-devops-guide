# syntax=docker/dockerfile:1

# ============================================================
#  ПРОСТОЙ ("наивный") Dockerfile — одна стадия.
#  Так чаще всего пишут в начале. Работает, но образ получается
#  большой: внутрь попадает ВЕСЬ Go-тулчейн (компилятор, кэш, исходники),
#  хотя для запуска нужен только готовый бинарь.
#
#  Собрать именно этот файл (он не дефолтный, поэтому через -f):
#    docker build -f Dockerfile.simple -t scott-pilgrim-quotes:simple .
# ============================================================
FROM golang:1.25-alpine

WORKDIR /app

# Копируем всё сразу и собираем прямо в этом же образе.
COPY . .
RUN go build -o server .

EXPOSE 8080

# CMD — команда запуска по умолчанию.
CMD ["./server"]
