# syntax=docker/dockerfile:1

# ============================================================
#  Stage 1 — СБОРКА (builder)
#  Здесь есть весь Go-тулчейн. Этот слой в финальный образ НЕ попадёт.
# ============================================================
FROM golang:1.25-alpine AS builder

WORKDIR /src

# Сначала копируем только go.mod (и go.sum, если появится).
# Это отдельный слой: пока зависимости не менялись — Docker берёт его из кэша,
# и `go mod download` не гоняется заново при каждой правке кода.
COPY go.mod ./
RUN go mod download

# Теперь копируем исходники и собираем СТАТИЧЕСКИЙ бинарь.
#   CGO_ENABLED=0  — без линковки с C-библиотеками => бинарь ни от чего не зависит,
#                    его можно положить в пустой образ (scratch/distroless).
#   -trimpath      — убираем абсолютные пути из бинаря (воспроизводимость).
#   -ldflags="-s -w" — выкидываем таблицу символов и отладочную инфу => меньше размер.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w" \
      -o /app/server .

# ============================================================
#  Stage 2 — РАНТАЙМ (финальный образ) на Alpine
#  Alpine — крошечный Linux (~7 MB) С shell (sh) и пакетником apk.
#  Берём его (а не distroless), чтобы можно было ЗАЙТИ внутрь:
#    kubectl exec -it <pod> -- sh   — удобно показывать/дебажить вживую.
#  Distroless ещё меньше и безопаснее (shell нет вообще), но в него
#  не зайдёшь — дебаг через ephemeral-контейнер (kubectl debug).
# ============================================================
FROM alpine:3.20

WORKDIR /app

# непривилегированный пользователь (не root)
RUN adduser -D -u 10001 appuser

# Копируем ТОЛЬКО собранный бинарь из стадии builder. Тулчейн остаётся позади.
COPY --from=builder /app/server /app/server

# Документируем порт (сам по себе порт не публикует, это подсказка).
EXPOSE 8080

USER appuser

ENTRYPOINT ["/app/server"]
